<%- include('../partials/head.ejs') %>
<%- include('../partials/navbar.ejs') %>


<div class="container-fluid px-0">
  <script>
    const mapToken = '<%-process.env.MAPBOX_publicToken%>';
    const campgrounds = {
      features: <%- JSON.stringify(campgrounds)%>
    };
  </script>
  <div class="mb-3" id="cluster-map"></div>
  <script src="/javascripts/clusterMap.js"></script>
</div>

<main class="container mt-5 mb-5">

  <%- include('../partials/flash.ejs') %>

  <h1>All campgrounds</h1>
  <% for(let camp of campgrounds){ %>
  <div class="card mb-3 p-2">
    <div class="row">
      <div class="col-md-4">
        <% if(camp.images[0]) {%>
        <img class="img-fluid" src="<%= camp.images[0].url%>" alt="" crossorigin>
        <% }%>
      </div>
      <div class="col-md-8">
        <h5 class="card-title">
          <%= camp.title %>
        </h5>
        <p class="card-text">
          <%= camp.description %>
        </p>
        <p class="card-text"><small class="text-muted">
            <%=camp.location%>
          </small></p>
        <a href="/campgrounds/<%=camp._id%>" class="btn btn-success">View <%= camp.title %> </a>
      </div>
    </div>
  </div>
  <% }%>

</main>

<%- include('../partials/footer.ejs') %>